                    <TextBlock x:Name="AppInfoCategory" FontSize="11" Foreground="#007ACC" TextWrapping="Wrap" />
                    <TextBlock x:Name="AppInfoPackage" Margin="0,3,0,0" FontSize="10" Foreground="#6B7280" TextWrapping="Wrap" />
                    <TextBlock x:Name="AppInfoCommand" Margin="0,3,0,0" FontSize="10" Foreground="#374151" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Popup>

    </Grid>
</Window>
